{
  "version": "1.0",
  "name": "oneSCM360 Tool Registry v1",
  "tools": [
    {
      "name": "search_knowledge",
      "purpose": "Knowledge Blocks und freigegebenes Wissen durchsuchen",
      "source_label": "oneSCM360 Store",
      "description": "Search approved internal oneSCM360 knowledge only.",
      "parameters": {
        "type": "object",
        "properties": {
          "query": {
            "type": "string",
            "description": "search terms"
          },
          "chapter": {
            "type": "string",
            "enum": [
              "CH01",
              "CH02",
              "CH03",
              "CH04",
              "CH05",
              "CH06",
              "CH07",
              "CH08",
              "CH09",
              "CH10",
              "CH11",
              "CH12",
              "CH13",
              "CH14",
              "CH15",
              "CH16"
            ],
            "description": "chapter id CH01-CH16"
          },
          "vehicle_type": {
            "type": "string",
            "enum": [
              "PC",
              "VAN",
              "CV",
              "ALL"
            ],
            "description": "vehicle division"
          },
          "status": {
            "type": "string",
            "enum": [
              "Draft",
              "Reviewed",
              "Released"
            ],
            "description": "review status"
          },
          "language": {
            "type": "string",
            "enum": [
              "DE",
              "EN"
            ],
            "description": "language"
          },
          "role": {
            "type": "string",
            "description": "role id, e.g. Dealer, MO, HQ"
          }
        },
        "required": [
          "query"
        ]
      },
      "security": {
        "classification": "INTERNAL",
        "network": "LOCAL_ONLY",
        "internet_access": false,
        "authentication_required": true,
        "authorization_required": true,
        "audit": true,
        "allowed_operations": [
          "READ"
        ],
        "blocked_operations": [
          "DELETE",
          "PUBLIC_SHARE",
          "EXTERNAL_EXPORT"
        ],
        "source": "onescm360",
        "writes": false,
        "confirmation_required": false
      }
    },
