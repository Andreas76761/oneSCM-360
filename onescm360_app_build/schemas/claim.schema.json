{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "claim.schema.json",
  "title": "oneSCM360 Claim",
  "type": "object",
  "required": ["claimId", "knowledgeId", "chapterId", "questionId", "canonicalStatement", "criticality", "validationStatus"],
  "properties": {
    "claimId": {"type": "string", "pattern": "^CLM-[A-Z0-9-]+$"},
    "knowledgeId": {"type": "string", "pattern": "^KB-[A-Z0-9-]+$"},
    "chapterId": {"type": "string", "pattern": "^CH(0[1-9]|1[0-6])$"},
    "questionId": {"type": "string", "pattern": "^[0-9]{2}-F(0[1-9]|1[0-9]|20)$"},
    "canonicalStatement": {"type": "string", "minLength": 1, "maxLength": 4000},
    "claimType": {"enum": ["FACT", "PERMISSION", "PROCESS", "STATUS", "SOURCE_SYSTEM", "RESTRICTION", "PLAN", "OTHER"]},
    "subject": {"type": "string", "maxLength": 200},
    "predicate": {"type": "string", "maxLength": 200},
    "object": {"type": "string", "maxLength": 500},
    "negated": {"type": "boolean"},
    "conditional": {"type": "boolean"},
    "uncertain": {"type": "boolean"},
    "criticality": {"enum": ["CRITICAL", "HIGH", "MEDIUM", "LOW"]},
    "division": {"enum": ["PC", "VAN", "BOTH", ""]},
    "role": {"type": "string", "maxLength": 200},
    "market": {"type": "string", "maxLength": 100},
    "pi": {"type": ["integer", "null"], "minimum": 0, "maximum": 99},
    "maturity": {"enum": ["PRODUCTION", "ACCEPTED", "IN_TEST", "IMPLEMENTED", "PLANNED", ""]},
    "tags": {"type": "array", "items": {"enum": ["permission", "financial", "irreversible", "security"]}},
    "evidenceStatus": {"enum": ["EVIDENCED", "NOT_EVIDENCED", "NOT_RELEVANT"]},
    "validationStatus": {"enum": ["DRAFT", "REVIEWED", "CONFIRMED", "REJECTED"]},
    "confidence": {"type": "number", "minimum": 0, "maximum": 1}
  }
}
